# Optional — enables the AI chat assistant to use Claude for richer answers.
# Without this key, the assistant still works using a built-in knowledge base.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — enables live PayPal checkout on the registration page.
# Without it, students can still register and pay by e-transfer.
# Get a client ID at https://developer.paypal.com (use your CAD business account).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
